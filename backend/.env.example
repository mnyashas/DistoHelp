# Copy to .env and adjust. All values have safe defaults for local dev.
# HAPI FHIR R4 base URL. Options:
#   (a) Docker:            docker compose up -d   -> http://localhost:8080/fhir   (preferred)
#   (b) Public sandbox:    https://hapi.fhir.org/baseR4                            (no Docker; public test data)
#   (c) Self-built starter: run jpaserver-starter  -> http://localhost:8080/fhir
HAPI_FHIR_URL=http://localhost:8080/fhir

# Where the app read-model (alerts/scores/patients) is stored
DB_PATH=./data/distohelp.db

# BIDMC dataset directory (PhysiNet bidmc 1.0.0). Leave unset to use bundled demo record.
# BIDMC_DIR=../data/bidmc

# Alert de-duplication window and missing-data threshold (minutes, simulated "wall" clock)
ALERT_DEDUP_MINUTES=10
MISSING_DATA_MINUTES=10

# Optional: relay escalation notifications to an SMS/WhatsApp webhook (MSG91, Twilio, ...)
# ESCALATION_WEBHOOK_URL=https://example.com/webhook

# --- Emergency notifications (panic button + URGENT auto-notify) ---
# NOTIFY_ON_CRITICAL=1        # 1 = emergency contacts get a message when an URGENT alert fires
# NOTIFY_PROVIDER=auto        # auto | msg91 | twilio_whatsapp | twilio | telegram | textbelt | screen
#   auto resolution order: msg91 -> twilio_whatsapp -> twilio -> telegram -> textbelt -> screen
#
# --- Provider A: MSG91 (India, free tier, REAL SMS — also MSG91 WhatsApp with business onboarding) ---
# 1. Sign up at msg91.com (free) -> Dashboard -> Auth Key
# 2. MSG91 needs a DLT-approved template for transactional SMS in India (route 4)
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=DISTOHLP        # 6-char sender id approved on DLT
# MSG91_ROUTE=4                   # 4 = transactional
# MSG91_TEMPLATE_ID=              # Flow template id (enables DLT-compliant v5 flow API)
# MSG91_VAR_KEY=VAR1              # name of the variable inside your Flow template (default VAR1); the full message is injected into it
# NOTE: MSG91 accepts submissions without validating your key — "success" means "queued".
# Real delivery evidence = the message on the recipient's phone, or the MSG91 dashboard / DLR webhook.
#
# --- Provider B: TWILIO (free trial $15 credit — no card; real SMS to VERIFIED numbers only) ---
# 1. Sign up at twilio.com -> Console -> Account SID + Auth Token
# 2. Trial must VERIFY the destination number first (Console -> Verified Caller IDs)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx        # your Twilio trial number (SMS)
#
# --- Provider C: TWILIO WHATSAPP SANDBOX (free, real WhatsApp) ---
# 1. Same Twilio account -> Messaging -> Try it out -> WhatsApp sandbox
# 2. The recipient sends the sandbox code to the sandbox number from THEIR WHATSAPP
#    (screen shows e.g. "join purple-tiger" -> message that text to +1 415 523 8886)
# 3. Then set:
# TWILIO_ACCOUNT_SID=ACxxxxxxxx   # can share with Provider B
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WA_FROM=+14155238886     # optional; defaults to the shared sandbox number
#
# --- Provider D: TELEGRAM (free, unlimited; contacts must /start your bot first) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789
#
# --- Provider E: TEXTBELT (no signup, 1 free SMS/day; free tier BLOCKED for India) ---
# TEXTBELT_KEY=textbelt
