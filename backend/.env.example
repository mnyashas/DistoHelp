# Copy to .env and adjust. All values have safe defaults for local dev.
# HAPI FHIR R4 base URL. Options:
#   (a) Docker:            docker compose up -d   -> http://localhost:8080/fhir   (preferred)
#   (b) Public sandbox:    https://hapi.fhir.org/baseR4                            (no Docker; public test data)
#   (c) Self-built starter: run jpaserver-starter  -> http://localhost:8080/fhir
HAPI_FHIR_URL=http://localhost:8080/fhir

# Where the app read-model (alerts/scores/patients) is stored
DB_PATH=./data/distohelp.db

# BIDMC dataset directory (PhysiNet bidmc 1.0.0). Leave unset to use bundled demo record.
# BIDMC_DIR=../data/bidmc

# Alert de-duplication window and missing-data threshold (minutes, simulated "wall" clock)
ALERT_DEDUP_MINUTES=10
MISSING_DATA_MINUTES=10

# Optional: relay escalation notifications to an SMS/WhatsApp webhook (MSG91, Twilio, ...)
# ESCALATION_WEBHOOK_URL=https://example.com/webhook
